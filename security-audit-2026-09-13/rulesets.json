{
  "mode": "run-all",
  "target": ".",
  "engine": "unavailable",
  "metrics": "off required",
  "rulesets": {
    "baseline": [
      "p/security-audit",
      "p/secrets",
      "p/owasp-top-ten",
      "p/cwe-top-25",
      "p/insecure-transport",
      "p/gitleaks"
    ],
    "typescript": [
      "p/typescript",
      "p/javascript",
      "p/nodejs"
    ],
    "third_party": [
      "https://github.com/trailofbits/semgrep-rules",
      "https://github.com/elttam/semgrep-rules",
      "https://github.com/apiiro/malicious-code-ruleset"
    ]
  }
}
